AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_TENANT_ID=<subscription-tenant-id>
PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
MODEL_DEPLOYMENT=<deployment-name>
BROWSER_CONNECTION_ID=<full-project-connection-resource-id>
BROWSER_MODE=workspace-mcp
BROWSER_WORKSPACE_MCP_URL=https://<region>.mcp.playwright.microsoft.com/playwrightworkspaces/<workspace-id>/mcp
# Required only for BROWSER_MODE=toolbox-mcp; no token or key values.
BROWSER_TOOLBOX_URL=https://<account>.services.ai.azure.com/api/projects/<project>/toolboxes/<name>/versions/<version>/mcp?api-version=v1
BROWSER_TOOLBOX_CONNECTION_ID=<temporary-remote-tool-connection-id>
DEMO_FORM_URL=https://<storage-static-website-host>/invoice-entry.html
DEMO_EXPECTED_MARKER=<marker-from-local-hosted-marker.json-not-from-a-prompt>
TEST_DEMO_MARKER=<same-locally-rendered-marker-for-ui-tests-only>
RESEARCH_WINDOW_START=<YYYY-MM-DD>
ARTIFACT_DIR=<absolute-local-artifact-directory>
